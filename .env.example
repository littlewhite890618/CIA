# ═══════════════════════════════════════════════
#  複製此檔為 .env 後填入實際值。.env 不進版控。
# ═══════════════════════════════════════════════

# ── Meta / Instagram 平台憑證 ──
# ⚠️ 後台有「兩組」編號與密鑰，別搞混：
#   應用程式編號／密鑰      → 基本資料頁，Facebook 層級
#   Instagram 應用程式編號／密鑰 → Instagram 產品頁，webhook 驗章用這組

# 來源：Meta App 後台 → 應用程式設定 → 基本資料
# 目前程式未使用，保留供日後呼叫 Graph API 之需
META_APP_SECRET=
# 自訂字串，需與 Meta App webhook 設定中填的值一致
META_WEBHOOK_VERIFY_TOKEN=

# 來源：Meta App 後台 → Instagram → API 設定
# ⚠️ webhook 的 X-Hub-Signature-256 是用這組密鑰簽的，不是 META_APP_SECRET。
#    填錯會導致每一筆真實 webhook 都驗章失敗（Meta 文件未載明此事）。
IG_APP_ID=
IG_APP_SECRET=

# 來源：Meta App 後台 → Instagram → API 設定 → 產生存取權杖
IG_ACCESS_TOKEN=
# 晴晴的 Instagram 專業帳號 ID（webhook payload 的 entry[].id）
IG_ACCOUNT_ID=
# 晴晴的 IG 帳號名稱（不含 @）。設定頁「回到聊天」會開 ig.me/m/<名稱>；
# 留空時改連到 Instagram 收件匣
IG_USERNAME=

# ── 資料庫 ──
# 正式環境為 PostgreSQL 16，由 docker-compose.yml 的 db 服務提供。
# 下面三個值同時用來初始化資料庫與組出容器內的連線字串。
# 密碼只用英數字：它會被組進連線字串，@ : / # ? 等符號會讓連線字串解析錯誤。
POSTGRES_USER=cia
POSTGRES_PASSWORD=請改成一組隨機密碼
POSTGRES_DB=cia

# 給「在主機上直接執行」用（uvicorn、alembic、轉檔腳本），經由 127.0.0.1:5432
# 連進容器內的 Postgres。容器內的 app 不讀這個值，compose 會改用 db 主機名覆寫。
# 帳密需與上面三個值一致。
# ⚠️ 主機名用 127.0.0.1，不要用 localhost：Windows 上 localhost 會先試 IPv6，
#    而 compose 只把埠綁在 IPv4，每次連線都會多卡好幾秒（2026-10-02 實測）。
# ⚠️ 埠是 15432 不是 5432：桌機原生的 PostgreSQL 服務已佔用 5432／5433，
#    連錯會連到別的資料庫。
DATABASE_URL=postgresql+psycopg://cia:請改成一組隨機密碼@127.0.0.1:15432/cia
# 容器資料庫對主機開放的埠，與上面 DATABASE_URL 的埠一致即可
POSTGRES_HOST_PORT=15432
# 不用 Docker、只想快速在本機跑時，可改回 SQLite（全新的檔案會自動建表）：
# DATABASE_URL=sqlite:///./data/local.db

# ── 對外公開網址（docker-compose.yml 的 ngrok 服務）──
# 來源：https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# 固定網域，不含 https://，例如 xxxx-xxxx.ngrok-free.app
NGROK_DOMAIN=

# ── 使用者設定頁（M13 任務 5.1）──
# 使用者在私訊傳「設定」，系統回一條帶簽章、有時效的設定頁連結。
# 兩個值任一未設定時功能關閉，「設定」會被當成一般訊息回覆。
# 服務的對外網址，要含 https://，通常就是 https:// 加上上面的 NGROK_DOMAIN
PUBLIC_BASE_URL=
# 連結的簽章密鑰，至少 32 字元，不可與其他密鑰共用。更換後所有已發出的連結立即失效。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SETTINGS_LINK_SECRET=
# 選填：連結有效秒數（預設 1800）、取得連結的關鍵字（預設「芝麻開門」，2026-10-21 由「設定」改來，
# 「設定」現在當一般聊天訊息）
# SETTINGS_LINK_TTL_SECONDS=1800
# SETTINGS_KEYWORD=芝麻開門

# ── LLM 供應層（依用途分三條路徑）──
DIALOG_PROVIDER=gemini
DIALOG_MODEL=gemini-2.0-flash
# 選填：dialog 主要模型重試用盡後改試這個，兩者都失敗才真正降級。
# 留空代表沒有備援。沿用 DIALOG_PROVIDER，只是換模型。
DIALOG_FALLBACK_MODEL=

ANALYSIS_PROVIDER=gemini
ANALYSIS_MODEL=gemini-2.0-flash
# 選填：analysis 主要模型重試用盡後改試這個。話題萃取（task 6.7）走
# 這條路徑，失敗不會讓使用者看到降級語句，但會讓話題記憶完全無法
# 累積，所以也值得接備援。留空代表沒有備援。
ANALYSIS_FALLBACK_MODEL=

COACHING_PROVIDER=gemini
COACHING_MODEL=gemini-2.0-flash

GEMINI_API_KEY=

# ── 可調參數 ──
# 靜默多久判定對話結束（秒）
SILENCE_THRESHOLD_SECONDS=1500
# 每角色帳號每小時發訊上限（未經官方證實，待實測）
SEND_RATE_LIMIT_PER_HOUR=200
# LLM 呼叫逾時（秒）
LLM_TIMEOUT_SECONDS=30
# 送入模型的近期訊息則數
DIALOG_CONTEXT_MESSAGE_COUNT=60
# 長對話摘要（M13 任務 8）：同一場次超過 TRIGGER 則時，保留最近 KEEP 則原文，
# 較早的寫成摘要；之後每再多 BATCH 則更新一次。KEEP 須小於 TRIGGER、不大於上面的則數
# SUMMARY_TRIGGER_MESSAGES=60
# SUMMARY_KEEP_RECENT=40
# SUMMARY_UPDATE_BATCH=20

# ── 執行環境 ──
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── 除錯逃生門 ──
# 略過 webhook 簽章驗證。只在「簽章驗不過、但需要先確認其餘管線」時打開，
# 問題解決後請關掉。僅在 ENVIRONMENT=development 時生效，
# 正式環境即使設為 true 也不會生效（見 config.skip_signature_check）。
WEBHOOK_SKIP_SIGNATURE_CHECK=false
